let [@inline] generate_bishop_attacks from occupancy =
  let blocker = bishop_masks.(from) &&& occupancy in
  bishop_table.(from).(index bishop_magics.(from) blocker bishop_shifts.(from))

let [@inline] generate_rook_attacks from occupancy =
  let blocker = rook_masks.(from) &&& occupancy in
  rook_table.(from).(index rook_magics.(from) blocker rook_shifts.(from))

let [@inline] generate_queen_attacks from occupancy =
  (generate_bishop_attacks from occupancy) ||| (generate_rook_attacks from occupancy)

let [@inline] generate_all_attacks pieces_bitboards oponent_pieces occupancy white_to_move =
  let all_attacks = ref 0L in
  let [@inline] aux pieces_bitboards generate_piece_attacks =
    let bitboard = ref pieces_bitboards in
    while !bitboard <> 0L do
      let from, other_pieces_bitboards = pop_lsb !bitboard in
      all_attacks := !all_attacks ||| (generate_piece_attacks from);
      bitboard := other_pieces_bitboards
    done
  in aux pieces_bitboards.(oponent_pieces.(pawn)) (fun [@inline] from -> generate_pawn_attacks from white_to_move);
  aux pieces_bitboards.(oponent_pieces.(knight)) generate_knight_attacks;
  aux pieces_bitboards.(oponent_pieces.(bishop)) (fun [@inline] from -> generate_bishop_attacks from occupancy);
  aux pieces_bitboards.(oponent_pieces.(rook)) (fun [@inline] from -> generate_rook_attacks from occupancy);
  aux pieces_bitboards.(oponent_pieces.(queen)) (fun [@inline] from -> generate_queen_attacks from occupancy);
  aux pieces_bitboards.(oponent_pieces.(king)) generate_king_attacks;
  !all_attacks

let push_function = [|(fun pawns -> Int64.shift_left pawns 8); (fun pawns -> Int64.shift_right_logical pawns 8)|]
let left_function = [|(fun pawns -> Int64.shift_left pawns 7); (fun pawns -> Int64.shift_right_logical pawns (-7))|]
let right_function = [|(fun pawns -> Int64.shift_left pawns 9); (fun pawns -> Int64.shift_right_logical pawns (-9))|]

let tab_print = [|"   |"; " P |"; " N |"; " B |"; " R |"; " Q |"; " K |"; " p |"; " n |"; " b |"; " r |"; " q |"; " k |"|]
let print_bitboard bitboard =
  let mailbox = Array.make 64 0 in
  let rec aux_1 mailbox index = match index with
    |[] -> ()
    |h::t ->
      mailbox.(h) <- 6;
      aux_1 mailbox t
  in aux_1 mailbox (index_list bitboard);
  let display = ref "   +---+---+---+---+---+---+---+---+\n"
  in for i = 8 downto 1 do
    let k_list = ref [] in
    let k = string_of_int i ^ "  |" in
    for j = 8 * (i - 1) to 8 * i - 1 do
      let piece = mailbox.(j) in
      k_list := tab_print.(piece) :: !k_list;
    done;
    k_list := List.rev !k_list;
    let k_str = String.concat "" !k_list in
    display := !display ^ (k ^ k_str ^ "\n" ^"   +---+---+---+---+---+---+---+---+\n");
  done;
  begin
    let fichier_sortie = open_out_gen [Open_creat; Open_text; Open_append] 0o666 "Harry.txt"
    in output_string fichier_sortie (!display ^ "     a   b   c   d   e   f   g   h\n");
    close_out fichier_sortie
  end;
  print_endline (!display ^ "     a   b   c   d   e   f   g   h\n")


let [@inline] generate_pawn_moves pawns_bitboard player_pieces white_to_move ep_bitboard not_occupancy oponent_occupancy moves number_of_moves ply =
  let promotion_rank = promotion_ranks.(white_to_move) in
  let push = push_function.(white_to_move) in
  let push_vect = push_vects.(white_to_move) in
  let left_vect = left_vects.(white_to_move) in
  let right_vect = right_vects.(white_to_move) in
  let single_pushes = push pawns_bitboard &&& not_occupancy in
  let left_attacks = left_function.(white_to_move) (pawns_bitboard &&& (Int64.lognot columns.(7))) in
  let right_attacks = right_function.(white_to_move) (pawns_bitboard &&& (Int64.lognot columns.(0))) in
  let double_pushes = push single_pushes &&& not_occupancy &&& double_push_ranks.(white_to_move) in
  let promotion_pushes = single_pushes &&& promotion_rank in
  let quiet_pushes = single_pushes ^^^ promotion_pushes in
  let left_captures = left_attacks &&& oponent_occupancy in
  let right_captures = right_attacks &&& oponent_occupancy in
  let left_promotions = left_captures &&& promotion_rank in
  let right_promotions = right_captures &&& promotion_rank in
  let regular_left_captures = left_captures &&& (Int64.lognot promotion_rank) in
  let regular_right_captures = right_captures &&& (Int64.lognot promotion_rank) in
  let left_ep = ep_bitboard &&& left_attacks in
  let right_ep = ep_bitboard &&& right_attacks in

  let player_pawn = player_pieces.(pawn) in
  let [@inline] aux moves_bitboard promotion_piece capture double_push enpassant vect =
    let bitboard = ref moves_bitboard in
    while !bitboard <> 0L do
      let to_, other_moves_bitboard = pop_lsb !bitboard in
      moves.(number_of_moves.(ply)) <- encode_move (to_ - vect) to_ player_pawn promotion_piece capture double_push 0 enpassant;
      number_of_moves.(ply) <- number_of_moves.(ply) + 1;
      bitboard := other_moves_bitboard
  done
  in aux quiet_pushes 0 0 0 0 push_vect;
  aux double_pushes 0 0 1 0 (2 * push_vect);
  aux regular_left_captures 0 1 0 0 left_vect;
  aux regular_right_captures 0 1 0 0 right_vect;
  aux left_ep 0 1 0 1 left_vect;
  aux right_ep 0 1 0 1 right_vect;
  for promotion_piece = player_pieces.(knight) to player_pieces.(queen) do
    aux left_promotions promotion_piece 1 0 0 left_vect;
    aux right_promotions promotion_piece 1 0 0 right_vect
  done

let [@inline] generate_castling_moves castling_rights white_to_move in_check occupancy moves number_of_moves ply from =
  let player_castling_info = castling_infos.(white_to_move) in
  let [@inline] aux to_king castling_rights castling mask empty_mask safe_mask = let _ = mask, safe_mask in
    if is_possible_castling castling_rights castling && (empty_mask &&& occupancy = 0L) then begin
      moves.(number_of_moves.(ply)) <- encode_move from to_king castling 0 0 0 1 0;
      number_of_moves.(ply) <- number_of_moves.(ply) + 1;
    end;
  in
  if not (in_check || from <> player_castling_info.from_king) then begin
    aux player_castling_info.to_short_king castling_rights player_castling_info.short_castling player_castling_info.short_castling_mask player_castling_info.short_castling_empty_mask player_castling_info.short_castling_safe_mask;
    aux player_castling_info.to_long_king castling_rights player_castling_info.long_castling player_castling_info.long_castling_mask player_castling_info.long_castling_empty_mask player_castling_info.long_castling_safe_mask
  end

let [@inline] generate_normal_moves piece sliding_attacks oponent_occupancy not_friendly_occupancy moves number_of_moves ply from =
  let captures_bitboard = sliding_attacks &&& oponent_occupancy in
  let [@inline] aux moves_bitboard capture =
    let bitboard = ref moves_bitboard in
    while !bitboard <> 0L do
      let to_, other_moves_bitboard = pop_lsb !bitboard in
      moves.(number_of_moves.(ply)) <- encode_move from to_ piece 0 capture 0 0 0;
      number_of_moves.(ply) <- number_of_moves.(ply) + 1;
      bitboard := other_moves_bitboard
    done;
  in aux captures_bitboard 1;
  aux (sliding_attacks &&& (Int64.logxor not_friendly_occupancy captures_bitboard)) 0

let pseudo_legal_moves position =
  let white_to_move = position.white_to_move in
  let ply = position.ply in
  let state = position.state.(position.ply) in
  let moves = position.moves.(ply) in
  let number_of_moves = position.number_of_moves in
  number_of_moves.(ply) <- 0;
  let friendly_occupancy = position.occupancy.(white_to_move) in
  let oponent_occupancy = position.occupancy.(white_to_move lxor 1)  in
  let total_occupancy = friendly_occupancy ||| oponent_occupancy in
  let not_occupancy = Int64.lognot total_occupancy in
  let in_check = state.in_check in
  let not_friendly_occupancy = Int64.lognot friendly_occupancy in
  let player_pieces = pieces_rep.(white_to_move) in
  let pieces_bitboard = position.pieces in

  (*Generate pawns moves*)
  generate_pawn_moves pieces_bitboard.(player_pieces.(pawn)) player_pieces white_to_move state.ep_bitboard not_occupancy oponent_occupancy moves number_of_moves ply;

  (*Generate castling moves*)
  generate_castling_moves state.castling_rights white_to_move in_check total_occupancy moves number_of_moves ply (lsb_index pieces_bitboard.(player_pieces.(king)));

  (*Generate normal moves*)
  let [@inline] aux piece pieces_bitboard generate_piece_attacks  =
    let bitboard = ref pieces_bitboard in
    while !bitboard <> 0L do
      let from, other_pieces_bitboard = pop_lsb !bitboard in
      let piece_attacks = generate_piece_attacks from in
      generate_normal_moves piece piece_attacks oponent_occupancy not_friendly_occupancy moves number_of_moves ply from;
      bitboard := other_pieces_bitboard
    done
  in
  aux player_pieces.(knight) pieces_bitboard.(player_pieces.(knight)) generate_knight_attacks;
  aux player_pieces.(bishop) pieces_bitboard.(player_pieces.(bishop)) (fun [@inline] from -> generate_bishop_attacks from total_occupancy);
  aux player_pieces.(rook) pieces_bitboard.(player_pieces.(rook)) (fun [@inline] from -> generate_rook_attacks from total_occupancy);
  aux player_pieces.(queen) pieces_bitboard.(player_pieces.(queen)) (fun [@inline] from -> generate_queen_attacks from total_occupancy);
  aux player_pieces.(king) pieces_bitboard.(player_pieces.(king)) generate_king_attacks

let [@inline] is_attacked square white_to_move occupancy pieces_bitboard oponent_pieces =
  (generate_pawn_attacks square white_to_move) &&& pieces_bitboard.(oponent_pieces.(pawn)) <> 0L ||
  knight_table.(square) &&& pieces_bitboard.(oponent_pieces.(knight)) <> 0L ||
  king_table.(square) &&& pieces_bitboard.(oponent_pieces.(king)) <> 0L ||
  (generate_bishop_attacks square occupancy) &&& (pieces_bitboard.(oponent_pieces.(queen)) ||| pieces_bitboard.(oponent_pieces.(bishop))) <> 0L ||
  (generate_rook_attacks square occupancy) &&& (pieces_bitboard.(oponent_pieces.(queen)) ||| pieces_bitboard.(oponent_pieces.(rook))) <> 0L

let [@inline] zobrist_index square piece =
  square * 12 + piece - 1

let white_to_move_zobrist = 768
let white_short_castling_zobrist = 769
let white_long_castling_zobrist = 770
let black_short_castling_zobrist = 771
let black_long_castling_zobrist = 772
let ep_zobrist = 773

(*Création d'un tableau de nombres pseudo aléatoires. 12 * 64 cases
  pour chaque pièce de chaque case, + 1 case pour indiquer le trait + 4 cases
  pour les droits roques + 8 cases pour les colonnes de capture en passant*)
let tab_zobrist = Array.make 781 0L

(*Condamné à sauter*)
type specific_castling_info = {
  mutable from_rook : int;
  to_rook : int;
  other_castling : int;
  castling_zobrist : int;
  other_castling_zobrist : int
}
let white_short_castling_info = {
  from_rook = castling_infos.(0).from_short_rook;
  to_rook = castling_infos.(0).to_short_rook;
  other_castling = 2;
  castling_zobrist = white_short_castling_zobrist;
  other_castling_zobrist = white_long_castling_zobrist
}
let white_long_castling_info = {
  from_rook = castling_infos.(0).from_long_rook;
  to_rook = castling_infos.(0).to_long_rook;
  other_castling = 1;
  castling_zobrist = white_long_castling_zobrist;
  other_castling_zobrist = white_short_castling_zobrist
}
let black_short_castling_info = {
  from_rook = castling_infos.(1).from_short_rook;
  to_rook = castling_infos.(1).to_short_rook;
  other_castling = 8;
  castling_zobrist = black_short_castling_zobrist;
  other_castling_zobrist = black_short_castling_zobrist
}
let black_long_castling_info = {
  from_rook = castling_infos.(1).from_long_rook;
  to_rook = castling_infos.(1).to_long_rook;
  other_castling = 4;
  castling_zobrist = black_long_castling_zobrist;
  other_castling_zobrist = black_short_castling_zobrist
}
let sweet_castling_info = 
  let acc = Array.make 9 white_short_castling_info in
  acc.(1) <- white_short_castling_info;
  acc.(2) <- white_long_castling_info;
  acc.(4) <- white_long_castling_info;
  acc.(8) <- white_long_castling_info;
  acc

let [@inline] update_castlings state castling =
  state.castling_rights <- state.castling_rights lxor castling;
  state.zobrist <- state.zobrist ^^^ tab_zobrist.(sweet_castling_info.(castling).castling_zobrist)

let [@inline] quiet_zobrist_update state piece from to_ final_piece =
  state.zobrist <- state.zobrist ^^^ tab_zobrist.(zobrist_index from piece) ^^^ tab_zobrist.(zobrist_index to_ final_piece)

let [@inline] capture_zobrist_update state piece from to_ captured_piece from_captured_piece final_piece =
  state.zobrist <- state.zobrist ^^^ tab_zobrist.(zobrist_index from piece) ^^^ tab_zobrist.(zobrist_index to_ final_piece) ^^^ tab_zobrist.(zobrist_index from_captured_piece captured_piece)

let [@inline] swaped_piece_bitboard bitboard from to_ =
  bitboard ^^^ single_bitboards_tab.(from) ^^^ single_bitboards_tab.(to_)

let [@inline] removed_piece_bitboard bitboard to_ =
  bitboard ^^^ single_bitboards_tab.(to_)

let [@inline] quiet_bitboard_update position white_to_move pieces_bitboard piece from to_ =
  pieces_bitboard.(piece) <- swaped_piece_bitboard pieces_bitboard.(piece) from to_;
  position.occupancy.(white_to_move) <- swaped_piece_bitboard position.occupancy.(white_to_move) from to_

let [@inline] capture_bitboard_update position white_to_move pieces_bitboard piece from to_ captured_piece to_captured_piece =
  quiet_bitboard_update position white_to_move pieces_bitboard piece from to_;
  pieces_bitboard.(captured_piece) <- removed_piece_bitboard pieces_bitboard.(captured_piece) to_captured_piece;
  position.occupancy.(white_to_move lxor 1) <- removed_piece_bitboard position.occupancy.(white_to_move lxor 1) to_captured_piece
  
let [@inline] update_aux position state white_to_move pieces_bitboard piece from to_ captured_piece from_captured_piece final_piece =
  if captured_piece = 0 then begin
    quiet_zobrist_update state piece from to_ final_piece;
    quiet_bitboard_update position white_to_move pieces_bitboard piece from to_
  end
  else begin
    capture_zobrist_update state piece from to_ captured_piece from_captured_piece final_piece;
    capture_bitboard_update position white_to_move pieces_bitboard piece from to_ captured_piece to_
  end

let [@inline] castling_rooks_aux position piece_square short_rook_square long_rook_square short_castling long_castling =
  if piece_square = short_rook_square && is_possible_castling position.castling_rights short_castling then begin
    update_castlings position short_castling
  end
  else if piece_square = long_rook_square && is_possible_castling position.castling_rights long_castling then begin
    update_castlings position long_castling
  end
  
let make_pawn_move () = ()

let make position move =
  let state = position.state.(position.ply) in
  let new_state = position.state.(position.ply + 1) in
  let white_to_move = position.white_to_move in
  let pieces_bitboard = position.pieces in
  let from = get_move_from move in
  let to_ = get_move_to move in
  let piece = get_move_piece move in
  let promotion_piece = get_move_promotion move in
  let castling_rights = state.castling_rights in
  let player_pieces = pieces_rep.(white_to_move) in
  let oponent_pieces = pieces_rep.(white_to_move lxor 1) in
  let player_castling_info = castling_infos.(white_to_move) in
  let oponent_castling_info = castling_infos.(white_to_move lxor 1) in
  let captured_piece = get_captured_piece move pieces_bitboard oponent_pieces to_ in
  new_state.captured_piece <- captured_piece;
  position.white_to_move <- white_to_move lxor 1;
  new_state.castling_rights <- castling_rights;
  new_state.zobrist <- state.zobrist ^^^ tab_zobrist.(white_to_move_zobrist);
  if state.ep_bitboard <> 0L then begin
    new_state.zobrist <- new_state.zobrist ^^^ tab_zobrist.(ep_zobrist + (lsb_index state.ep_bitboard land 7));
  end;
  new_state.ep_bitboard <- 0L;
  new_state.half_moves <- state.half_moves + 1;

  (*Pawn moves*)
  if is_pawn piece then begin
    new_state.half_moves <- 0;

    (*Double push*)
    if get_move_double_push move <> 0 then begin
      if (pieces_bitboard.(oponent_pieces.(pawn)) &&& enpassant_table.(to_) <> 0L) then begin
        new_state.ep_bitboard <- single_bitboards_tab.((from + to_) / 2);
        new_state.zobrist <- new_state.zobrist ^^^ tab_zobrist.(ep_zobrist + (from land 7))
      end;
      quiet_zobrist_update new_state piece from to_ piece;
      quiet_bitboard_update position white_to_move pieces_bitboard piece from to_;
    end

    (*Prise en passant*)
    else if get_move_enpassant move <> 0 then begin
      let captured_pawn_square = (to_ - push_vects.(white_to_move)) in
      let captured_pawn = oponent_pieces.(pawn) in
      capture_zobrist_update new_state piece from to_ captured_pawn captured_pawn_square piece;
      capture_bitboard_update position white_to_move pieces_bitboard piece from to_ captured_pawn captured_pawn_square

    end

    (*Promotion*)
    else if promotion_piece <> 0 then begin
      update_aux position new_state white_to_move pieces_bitboard piece from to_ captured_piece to_ promotion_piece;
      castling_rooks_aux new_state to_ oponent_castling_info.from_short_rook oponent_castling_info.from_long_rook oponent_castling_info.short_castling oponent_castling_info.long_castling
    end

    (*Single push or normal capture*)
    else begin
      update_aux position new_state white_to_move pieces_bitboard piece from to_ captured_piece to_ piece;
      castling_rooks_aux new_state to_ oponent_castling_info.from_short_rook oponent_castling_info.from_long_rook oponent_castling_info.short_castling oponent_castling_info.long_castling;
    end
  end

  (*Castling*)
  else if get_move_castling move <> 0 then begin
    let player_rook = player_pieces.(rook) in
    let player_king = player_pieces.(king) in
    let sweet_info = sweet_castling_info.(piece) in
    let from_rook = sweet_info.from_rook in
    let to_rook = sweet_info.to_rook in
    pieces_bitboard.(player_king) <- swaped_piece_bitboard pieces_bitboard.(player_king) from to_;
    pieces_bitboard.(player_rook) <- swaped_piece_bitboard pieces_bitboard.(player_rook) from_rook to_rook;
    if is_possible_castling state.castling_rights sweet_info.other_castling then begin
      new_state.zobrist <-
        state.zobrist ^^^ tab_zobrist.(sweet_info.castling_zobrist) ^^^ tab_zobrist.(sweet_info.other_castling_zobrist) ^^^
        tab_zobrist.(zobrist_index from player_king) ^^^ tab_zobrist.(zobrist_index to_ player_king) ^^^
        tab_zobrist.(zobrist_index from_rook player_rook) ^^^ tab_zobrist.(zobrist_index to_rook player_rook)
    end
    else begin
      new_state.zobrist <-
        state.zobrist ^^^ tab_zobrist.(sweet_info.castling_zobrist) ^^^
        tab_zobrist.(zobrist_index from player_king) ^^^ tab_zobrist.(zobrist_index to_ player_king) ^^^
        tab_zobrist.(zobrist_index from_rook player_rook) ^^^ tab_zobrist.(zobrist_index to_rook player_rook)
    end
  end

  (*Normal move*)
  else if from + to_ <> 0 then begin
    update_aux position new_state white_to_move pieces_bitboard piece from to_ captured_piece to_ piece;
    if is_king piece then begin
      if to_ = oponent_castling_info.from_short_rook && is_possible_castling castling_rights oponent_castling_info.short_castling then begin
        update_castlings new_state oponent_castling_info.short_castling
      end
      else if to_ = oponent_castling_info.from_long_rook && is_possible_castling castling_rights oponent_castling_info.long_castling then begin
        update_castlings new_state oponent_castling_info.long_castling
      end
      else begin
        if is_possible_castling castling_rights player_castling_info.short_castling then begin
          update_castlings new_state player_castling_info.short_castling
        end;
        if is_possible_castling castling_rights player_castling_info.long_castling then begin
          update_castlings new_state player_castling_info.long_castling
        end
      end
    end
    else begin
      castling_rooks_aux new_state to_ oponent_castling_info.from_short_rook oponent_castling_info.from_long_rook oponent_castling_info.short_castling oponent_castling_info.long_castling;
      castling_rooks_aux new_state from player_castling_info.from_short_rook player_castling_info.from_long_rook player_castling_info.short_castling player_castling_info.long_castling;
    end;
    if captured_piece <> 0 then begin
      new_state.half_moves <- 0
    end
  end;
  position.ply <- position.ply + 1

let [@inline] unmake_aux position white_to_move pieces_bitboard piece from to_ captured_piece =
  if captured_piece = 0 then begin
    quiet_bitboard_update position white_to_move pieces_bitboard piece from to_
  end
  else begin
    capture_bitboard_update position white_to_move pieces_bitboard piece from to_ captured_piece to_
  end

let unmake position move =
  let white_to_move = position.white_to_move in
  let pieces_bitboard = position.pieces in
  let player_pieces = pieces_rep.(white_to_move) in
  let oponent_pieces = pieces_rep.(white_to_move lxor 1) in let _ = oponent_pieces in
  position.white_to_move <- position.white_to_move lxor 1;
  let from = get_move_from move in
  let to_ = get_move_to move in
  let piece = get_move_piece move in
  let promotion_piece = get_move_promotion move in
  let captured_piece = position.state.(position.ply).captured_piece in

  (*Pawn moves*)
  if is_pawn piece then begin

    (*En passant*)
    if get_move_enpassant move <> 0 then begin
      let captured_pawn_square = (to_ + push_vects.(white_to_move)) in
      let captured_pawn = player_pieces.(pawn) in
      capture_bitboard_update position (white_to_move lxor 1) pieces_bitboard piece from to_ captured_pawn captured_pawn_square
    end

    (*Promotion*)
    else if promotion_piece <> 0 then begin
      unmake_aux position (white_to_move lxor 1) pieces_bitboard piece from to_ captured_piece;
    end

    (*Push or normal capture*)
    else begin
      unmake_aux position (white_to_move lxor 1) pieces_bitboard piece from to_ captured_piece
    end
  end

  (*Castling*)
  else if get_move_castling move <> 0 then begin
    let player_rook = player_pieces.(rook) in
    let player_king = player_pieces.(king) in
    let sweet_info = sweet_castling_info.(piece) in
    let from_rook = sweet_info.from_rook in
    let to_rook = sweet_info.to_rook in
    pieces_bitboard.(player_king) <- swaped_piece_bitboard pieces_bitboard.(player_king) to_ from;
    pieces_bitboard.(player_rook) <- swaped_piece_bitboard pieces_bitboard.(player_rook) to_rook from_rook;
  end

  (*Normal move*)
  else if from + to_ <> 0 then begin
    unmake_aux position (white_to_move lxor 1) pieces_bitboard piece from to_ captured_piece
  end;
  position.ply <- position.ply - 1

let legal_moves position =
  let white_to_move = position.white_to_move in
  let pieces_bitboard = position.pieces in
  let player_pieces = pieces_rep.(white_to_move) in
  let oponent_pieces = pieces_rep.(white_to_move lxor 1) in
  let pieces = position.pieces in
  pseudo_legal_moves position;
  let occupancy = position.occupancy in
  let ply = position.ply in
  let number_of_moves = position.number_of_moves in
  let moves = position.moves.(ply) in
  let i = ref 0 in
  while !i < number_of_moves.(ply) do
    let move = moves.(!i) in
    make position move;
    if is_attacked (lsb_index pieces.(player_pieces.(king))) white_to_move (occupancy.(0) ||| occupancy.(1)) pieces_bitboard oponent_pieces then begin
      remove_move moves number_of_moves ply !i
    end
    else begin
      incr i
    end;
    unmake position move;
  done