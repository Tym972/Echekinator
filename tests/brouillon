(*          binary move bits                               hexidecimal constants
    
    0000 0000 0000 0000 0011 1111    from square                 0x3f
    0000 0000 0000 1111 1100 0000    to square                   0xfc0
    0000 0000 1111 0000 0000 0000    piece                       0xf000
    0000 1111 0000 0000 0000 0000    promotion piece             0xf0000
    0001 0000 0000 0000 0000 0000    capture flag                0x100000
    0010 0000 0000 0000 0000 0000    double push flag            0x200000
    0100 0000 0000 0000 0000 0000    castling flag               0x400000
    1000 0000 0000 0000 0000 0000    enpassant flag              0x800000
*)

type flags = {
  capture : int;
