let (|||) = Int64.logor
let (^^^) = Int64.logxor

let [@inline] lsb bitboard =
  bitboard &&& (Int64.neg bitboard)

let de_bruijn_constant = 0x03f79d71b4cb0a89L

let index64 = [|
    0;  1; 48;  2; 57; 49; 28;  3;
   61; 58; 50; 42; 38; 29; 17;  4;
   62; 55; 59; 36; 53; 51; 43; 22;
   45; 39; 33; 30; 24; 18; 12;  5;
