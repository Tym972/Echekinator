}

let [@inline] encode_move from to_ piece promotion_piece capture double_push castling enpassant =
  from lor (Int.shift_left to_  6) lor (Int.shift_left piece 12) lor (Int.shift_left promotion_piece 16) lor (Int.shift_left capture 20) lor (Int.shift_left double_push 21) lor (Int.shift_left castling 22) lor (Int.shift_left enpassant 23) 

let [@inline] get_move_from move =
  move land 0x3f

let [@inline] get_move_to move =
  (move land 0xfc0) lsr 6

let [@inline] get_move_piece move =
  (move land 0xf000) lsr 12

let [@inline] get_move_promotion move =
  (move land 0xf0000) lsr 16

let [@inline] get_move_capture move =
  move land 0x100000

let [@inline] get_move_double_push move =
  move land 0x200000

let [@inline] get_move_castling move =
  move land 0x400000

let [@inline] get_move_enpassant move =
  move land 0x800000

let [@inline] get_captured_piece move pieces_bitboards oponent_pieces to_ =
  if get_move_capture move = 0 then begin
    0
  end
  else begin
    let square_bitboard = single_bitboards_tab.(to_) in
    if square_bitboard &&& pieces_bitboards.(oponent_pieces.(pawn)) <> 0L then begin
      oponent_pieces.(pawn)
    end
    else if square_bitboard &&& pieces_bitboards.(oponent_pieces.(knight)) <> 0L then begin
      oponent_pieces.(knight)
    end
    else if square_bitboard &&& pieces_bitboards.(oponent_pieces.(bishop)) <> 0L then begin
      oponent_pieces.(bishop)
    end
    else if square_bitboard &&& pieces_bitboards.(oponent_pieces.(rook)) <> 0L then begin
      oponent_pieces.(rook)
    end
    else begin
      oponent_pieces.(queen)
    end
  end

let isquiet move = get_move_capture move = 0 && get_move_promotion move = 0

